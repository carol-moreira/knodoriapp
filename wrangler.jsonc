{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "knodori-app",
  "compatibility_date": "2026-06-13",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  // Worker: responde apenas /api/* (motor de precificação com taxas secretas).
  "main": "server/worker.ts",
  // App Angular (build estático). Qualquer rota desconhecida cai no index.html.
  "assets": {
    "directory": "./dist/knodori/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
}
