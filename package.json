{
  "name": "knodori",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c magenta,cyan \"ng serve\" \"npm run dev:api\"",
    "dev:web": "ng serve",
    "dev:api": "node -e \"require('fs').mkdirSync('dist/knodori/browser',{recursive:true})\" && wrangler dev --port 8787",
    "build": "ng build",
    "build:dev": "ng build --configuration development",
    "preview": "ng build && wrangler dev --port 8787",
    "deploy": "ng build && wrangler deploy",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "clsx": "^2.1.1",
    "lucide-angular": "0.575.0",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.5.0",
    "tslib": "^2.8.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@angular/build": "^20.3.0",
    "@angular/cli": "^20.3.0",
    "@angular/compiler-cli": "^20.3.0",
    "@eslint/js": "^9.32.0",
    "@tailwindcss/postcss": "^4.2.1",
    "angular-eslint": "^20.3.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "globals": "^15.15.0",
    "postcss": "^8.5.0",
    "prettier": "^3.7.3",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.56.1",
    "wrangler": "^4.20.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "lmdb@3.4.2": true,
    "msgpackr-extract@3.0.4": true,
    "@parcel/watcher@2.6.0": true,
    "workerd@1.20261006.1": true
  }
}
